{
    "manifest_version": 3,
    "name": "__MSG_extensionName__",
    "version": "2.0.1",
    "default_locale": "fr",
    "description": "__MSG_extensionDescription__",
    "author": "DoulBrowser Team",
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "permissions": [
        "webRequest",
        "storage",
        "tabs",
        "activeTab",
        "scripting",
        "alarms",
        "cookies"
    ],
    "host_permissions": [
        "http://*/*",
        "https://*/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "bridge.js"
            ],
            "world": "MAIN",
            "run_at": "document_start",
            "all_frames": true
        },
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_start",
            "all_frames": true
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "bridge.js"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ]
}